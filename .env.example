# Copy to .env for local dev (never commit .env).

# Nebius Token Factory: every text and vision model (NVIDIA Nemotron).
NEBIUS_API_KEY=
# Tavily: web research for building rules of cities without a built-in rule pack.
TAVILY_API_KEY=

# Google Cloud project for Firestore, Cloud Storage and the Gemini image models (Vertex AI, "global" endpoint).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Local only: Application Default Credentials for that project.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Identity Platform browser key for email sign-in (guests can use everything without it).
NAQSHA_AUTH_API_KEY=
